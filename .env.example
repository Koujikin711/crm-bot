# METODI CRM — скопируй в .env и подставь свои значения
# На Amvera задавай эти переменные в настройках проекта (не коммить .env!)

# Telegram
API_TOKEN=your_telegram_bot_token
OWNER_ID=123456789

# База данных (на Amvera лучше /data/crm_base.db)
CRM_DB_PATH=./crm_base.db

# Green API — бизнес
ID_INSTANCE=7103499086
API_TOKEN_INSTANCE=your_green_api_token
API_URL=https://7103.api.greenapi.com

# Green API — медицина (если отдельный инстанс)
MED_ID_INSTANCE=7103507365
MED_API_TOKEN=your_med_green_api_token
MED_API_URL=https://7103.api.greenapi.com

# Google Sheets — база лидов для SMS-рассылки (опционально)
# GOOGLE_SHEET_ID= из URL таблицы: docs.google.com/spreadsheets/d / HERE / edit
# GOOGLE_SHEET_TAB_NAME=База данных лидов
# GOOGLE_CREDENTIALS_JSON= строка JSON ключа сервисного аккаунта (см. GOOGLE_SHEET_SETUP.md)
